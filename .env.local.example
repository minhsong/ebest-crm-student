# ===========================================
# Student Portal - Environment config
# ===========================================
# Copy → .env.local và sửa giá trị.

# CRM API (server-side only — không NEXT_PUBLIC)
CRM_API_URL=http://localhost:3001

# === M2M service keys (mô hình A: 1 inbound key / service) ===
# Portal chỉ giữ outbound keys tới CRM + Gateway. Không key theo chức năng.
# Outbound → CRM (khớp CRM_SERVICE_KEY trên ebest-crm-api)
CRM_SERVICE_KEY=change_me_crm_service_key
# Outbound → Social Gateway (khớp GATEWAY_SERVICE_KEY trên gateway)
GATEWAY_SERVICE_KEY=change_me_gateway_service_key
SOCIAL_GATEWAY_BASE_URL=http://localhost:3040

# Socket.IO (browser)
NEXT_PUBLIC_SOCIAL_GATEWAY_WS_ORIGIN=http://localhost:3040
# NEXT_PUBLIC_SOCIAL_GATEWAY_WS_PATH=/socket.io

# Phase test: hiện chi tiết lỗi mock-test trên UI + nút Copy
# NEXT_PUBLIC_MOCK_TEST_SHOW_ERROR_DETAILS=true

# Log SSR Portal→CRM (stdout process Next): request URL, status, actor summary
# PORTAL_SSR_DEBUG=true

# STUDENT_PORTAL_ORIGIN trên CRM phải trùng URL công khai portal
# SITE_URL=https://student.ebest.edu.vn

# reCAPTCHA v3 (client site key; secret trên CRM)
# NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=

# SEO canonical (WordPress landing)
# MOCK_TEST_LANDING_CANONICAL_URL=
# MOCK_TEST_ONLINE_LANDING_CANONICAL_URL=
